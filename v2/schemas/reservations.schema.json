{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro-next.local/schemas/reservations.schema.json",
  "title": "Maestro Next Active Reservations",
  "type": "object",
  "required": ["reservations", "updated_at"],
  "properties": {
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "workstream", "mode"],
        "properties": {
          "pattern": { "type": "string" },
          "workstream": { "type": "string" },
          "agent": { "type": ["string", "null"] },
          "mode": { "enum": ["exclusive", "coordinated", "read-only"] },
          "reason": { "type": ["string", "null"] },
          "expires_when": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
